# Copy to .env for local development (`pnpm bootstrap` does it). Never commit .env.

# --- Local Postgres (compose.yaml reads these from .env) ---
# Docker Compose project name: keeps this checkout's container and volume apart from other projects. Give each
# project on this machine its own name, and its own ports below.
COMPOSE_PROJECT_NAME=app
# Host port and password of the Postgres container. DATABASE_URL below must use the same values.
POSTGRES_PORT=54329
POSTGRES_PASSWORD=app-local
# Host ports of Mailpit (`pnpm mail:up`): SMTP, and the web inbox with its API. SMTP_URL below uses the first.
MAILPIT_SMTP_PORT=54325
MAILPIT_HTTP_PORT=54380

# --- App ---
DATABASE_URL=postgres://app:app-local@127.0.0.1:54329/app
# Public origin of the app (scheme + host + port, no path).
APP_URL=http://localhost:3000
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set only behind a reverse proxy: its addresses or CIDR ranges, comma-separated (e.g. 127.0.0.1/32 for a
# proxy on the same host). The proxy must append the client to X-Forwarded-For. Unset = the TCP peer is the
# client and X-Forwarded-For is ignored. See docs/operations.md.
TRUSTED_PROXIES=
# Postgres connections per process (default 10).
# DATABASE_POOL_MAX=10
# true when DATABASE_URL is a connection pooler (PgBouncer, Neon, Supabase); then migrations need a direct
# MIGRATION_DATABASE_URL. See docs/operations.md, "Connection poolers".
# DATABASE_URL_POOLED=false
# MIGRATION_DATABASE_URL=

# --- Auth and mail ---
# Who may create accounts: closed (default: only `pnpm user:create`) or open (anyone, through /sign-up, with
# email verification; needs SMTP_URL). See docs/decisions/0003-sign-up-policy.md.
AUTH_SIGN_UP=closed
# Outgoing mail (verification, password reset): smtp:// (STARTTLS) or smtps:// (TLS), credentials
# percent-encoded in the URL, e.g. smtps://user:password@smtp.example.com:465. Locally, Mailpit. Unset = mail is
# only logged and never delivered. MAIL_FROM is required with SMTP_URL.
SMTP_URL=smtp://127.0.0.1:54325
MAIL_FROM="App <no-reply@localhost>"

# --- Tests (optional) ---
# verify:app, lighthouse and check:drift each create and drop app_<purpose>_<pid>_test next to
# DATABASE_URL. To use a fixed database instead (name must end in _test; it is dropped and recreated at
# the start of the run and not dropped afterwards):
# TEST_DATABASE_URL=postgres://app:app-local@127.0.0.1:54329/app_test
# LIGHTHOUSE_DATABASE_URL=postgres://app:app-local@127.0.0.1:54329/app_lighthouse_test
# DRIFT_DATABASE_URL=postgres://app:app-local@127.0.0.1:54329/app_drift_test
# verify:app keeps its per-run database after the run instead of dropping it.
# KEEP_TEST_DB=1
# verify:app and lighthouse test .output even if it is older than its sources.
# ALLOW_STALE_BUILD=1
# Fixed port for the app verify:app starts (default: a free port).
# VERIFY_PORT=3100
