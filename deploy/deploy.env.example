# Settings for compose.production.yaml. Copy to deploy.env on the server and fill in real values; deploy.env is
# gitignored and must never be committed. Every value below is a placeholder.

# The image to run, built and pushed by you: `docker build -t "$APP_IMAGE" . && docker push "$APP_IMAGE"`.
APP_IMAGE=registry.example.com/app:2026-09-27

# The public host name. Its DNS must point at the server, and ports 80 and 443 must reach it.
DOMAIN=app.example.com

# Hex keeps the passwords safe inside a URL: openssl rand -hex 24
POSTGRES_PASSWORD=placeholder-openssl-rand-hex-24
APP_DB_PASSWORD=placeholder-openssl-rand-hex-24

# openssl rand -base64 32
BETTER_AUTH_SECRET=placeholder-openssl-rand-base64-32

# closed: accounts come from create-user (docs/operations.md, "Deploy on one server with Docker Compose").
AUTH_SIGN_UP=closed
# Outgoing mail (password resets, and email confirmation with AUTH_SIGN_UP=open). Unset: mail is only logged.
SMTP_URL=
MAIL_FROM=
