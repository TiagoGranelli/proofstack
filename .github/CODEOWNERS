# The quality gates decide what "done" means for every change, agent-written ones included. A pull request that
# loosens them (a rule turned off, a threshold raised, a module dropped from COVERAGE_GATE, a selector dropped from
# .oxlintrc.json, an entry in PUBLIC_OPERATIONS) needs a review from the owners below. Replace
# @proofstack/maintainers with the real team or user, and require code-owner review in the branch protection of
# main; until then this file only suggests reviewers. The last matching pattern wins, so later lines narrow earlier
# ones.

# Lint, types, dead code, complexity, duplication, formatting.
/.oxlintrc.json      @proofstack/maintainers
/.oxfmtrc.json       @proofstack/maintainers
/.fallowrc.json      @proofstack/maintainers
/tsconfig.json       @proofstack/maintainers

# Test gates: COVERAGE_GATE and the projects live in vitest.config.ts.
/vitest.config.ts    @proofstack/maintainers
/playwright.config.ts @proofstack/maintainers

# The gate list and pre-commit hook, the repository rules, the public operations, the drift checks.
/lefthook.yml                        @proofstack/maintainers
/tests/unit/repo-policy.test.ts      @proofstack/maintainers
/tests/api/public-operations.test.ts @proofstack/maintainers
/scripts/check-drift.ts              @proofstack/maintainers
/scripts/ci-jobs.ts                  @proofstack/maintainers

# Supply chain: exact versions, build-script, release-age and trust exceptions, overrides, vulnerability and
# license allowlists, secret-scan and migration-lint exceptions.
/package.json                 @proofstack/maintainers
/pnpm-workspace.yaml          @proofstack/maintainers
/security/                    @proofstack/maintainers
/scripts/licenses.ts          @proofstack/maintainers
/scripts/audit.ts             @proofstack/maintainers
/scripts/allowlist.ts         @proofstack/maintainers
/scripts/images.ts            @proofstack/maintainers
/.gitleaks.toml               @proofstack/maintainers
/.squawk.toml                 @proofstack/maintainers

# CI workflows, actions, Dependabot and this file.
/.github/            @proofstack/maintainers
