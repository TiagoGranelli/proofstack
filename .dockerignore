# Keep the build context to what `pnpm install && pnpm build` needs.
# Build output and local artifacts stay out: they are large, can hold secrets or test data, and would
# be copied by `COPY . .`. (Tailwind scans only src/: `source("../")` in src/styles/app.css.)

# Same entries as .gitignore (keep in sync)
node_modules/
.output/
.nitro/
.tanstack/
.fallow/
dist/
coverage/
test-results/
playwright-report/
.lighthouseci/
lighthouse-report/
sbom/
*.log
.env
.env.*
!.env.example
deploy/deploy.env
lefthook-local.yml
.DS_Store

# Not needed to build the image
.git/
.github/
lefthook.yml
.vscode/
.agents/
.claude/
repos/
docs/
.grype.yaml
deploy/
.gitleaks.toml
.squawk.toml
tests/
Dockerfile
.dockerignore
