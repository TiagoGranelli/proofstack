{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "sortImports": {
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "stylesheet": "./src/styles/app.css"
  },
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".fallow/**",
    "coverage/**",
    "test-results/**",
    "playwright-report/**",
    "lighthouse-report/**",
    "src/routeTree.gen.ts",
    "pnpm-lock.yaml",
    ".agents/**",
    ".claude/**",
    "**/*.md"
  ]
}
