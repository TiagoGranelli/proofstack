{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    "node_modules/**",
    ".output/**",
    ".nitro/**",
    ".tanstack/**",
    ".fallow/**",
    "drizzle/**",
    "repos/**",
    "src/sdk/**",
    "src/routeTree.gen.ts",
    "test-results/**",
    "playwright-report/**",
    ".agents/**",
    ".claude/**",
    "lighthouse-report/**",
    "coverage/**",
    // Hidden eval checks import tests/<layer> helpers by the path they get when evals/grade.sh copies them there.
    "evals/**"
  ],
  "plugins": ["typescript", "unicorn", "oxc", "import", "react", "jsx-a11y", "promise"],
  "jsPlugins": [
    "@shadcn/lint",
    "@tanstack/eslint-plugin-query",
    "@tanstack/eslint-plugin-router",
    "eslint-plugin-playwright",
    // ESLint's core rules, for `no-restricted-syntax`, which oxlint has no native version of. The object form,
    // because the plain specifier resolves the wrong plugin name (oxc#23695).
    { "name": "eslint-js", "specifier": "oxlint-plugin-eslint" }
  ],
  // Every rule is "error" or "off" (`pnpm lint` runs with --deny-warnings). `pedantic` is on as a whole; each rule
  // turned off below was measured on this code base and says why. An escape hatch for one line is an
  // `oxlint-disable-next-line <rule>` directly under a comment giving the reason (tests/unit/repo-policy.test.ts
  // rejects a bare one, and `reportUnusedDisableDirectives` rejects a stale one).
  //
  // Repository rules are `eslint-js/no-restricted-syntax` selectors in the overrides at the end. An override
  // replaces the whole selector list of an earlier one, so each list repeats the selectors of the wider globs.
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "settings": {
    "shadcn": {
      "note": "Theme tokens live in src/styles/app.css; shadcn primitives live in src/components/ui (add new ones with `pnpm exec shadcn add`)."
    }
  },
  "options": {
    "reportUnusedDisableDirectives": "error"
  },
  "rules": {
    // On Windows pnpm, npm and node_modules/.bin tools are `.cmd` shims, which Node refuses to start without a shell
    // (CVE-2024-27980); tinyexec resolves them and escapes their arguments for cmd.exe.
    "eslint-js/no-restricted-syntax": [
      "error",
      {
        "selector": "CallExpression:matches([callee.name=/^(spawn|spawnSync|execFile|execFileSync)$/], [callee.property.name=/^(spawn|spawnSync|execFile|execFileSync)$/])[arguments.0.value=/^(pnpm|npm|npx|yarn)$|^node_modules/]",
        "message": "Start pnpm, npm or a node_modules/.bin tool with `xSync` or `x` from tinyexec, not node:child_process: on Windows it is a `.cmd` shim, which Node refuses to start without a shell (CVE-2024-27980)."
      }
    ],
    "react/react-in-jsx-scope": "off",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }],
    "oxc/no-barrel-file": ["error", { "threshold": 0 }],
    "react/rules-of-hooks": "error",
    "react/no-unstable-nested-components": [
      "error",
      {
        "allowAsProps": true
      }
    ],
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["@tanstack/react-start/server-only", "**/*.css"]
      }
    ],
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ],
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": [
      "error",
      {
        "checksVoidReturn": {
          "attributes": false
        }
      }
    ],
    "typescript/await-thenable": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/consistent-return": "off",

    // pedantic, turned off. Style preferences that would rewrite correct code, or rules that fight a library's shape.
    "typescript/prefer-readonly-parameter-types": "off",
    "eslint/require-unicode-regexp": "off",
    // Size limits: complexity and max-lines-per-function below measure what matters.
    "eslint/max-lines": "off",
    "eslint/max-depth": "off",
    "eslint/max-classes-per-file": "off",
    "import/max-dependencies": "off",
    "typescript/strict-void-return": "off",
    "unicorn/explicit-length-check": "off",
    // `new Promise((resolve) => setTimeout(resolve, ms))` is the idiom it flags.
    "eslint/no-promise-executor-return": "off",
    "unicorn/no-useless-undefined": "off",
    // Its fix changes behavior: `Number.parseFloat("2px")` is 2, `Number("2px")` is NaN (CSS values in tests/e2e).
    "unicorn/prefer-number-coercion": "off",
    // Better Auth hooks and TanStack loaders must be async functions even when they await nothing.
    "eslint/require-await": "off",
    "typescript/require-await": "off",
    // Effect Schema declares a const and a type of the same name (`const Post = Schema.Struct(...)`, `type Post`).
    "eslint/no-redeclare": "off",
    "eslint/no-negated-condition": "off",
    "unicorn/no-negated-condition": "off",
    "unicorn/prefer-query-selector": "off",
    "eslint/no-loop-func": "off",
    "react/no-unescaped-entities": "off",

    // pedantic, calibrated.
    // Nullable strings, booleans and objects read naturally in conditions; numbers and any/unknown do not
    // (`if (count)` hides 0, `if (error)` hides a falsy thrown value).
    "typescript/strict-boolean-expressions": [
      "error",
      {
        "allowString": true,
        "allowNumber": true,
        "allowNullableObject": true,
        "allowNullableBoolean": true,
        "allowNullableString": true,
        "allowNullableNumber": false,
        "allowNullableEnum": false,
        "allowAny": false
      }
    ],
    // TanStack Router's `throw redirect(...)` and `throw notFound()` are its control flow.
    "typescript/only-throw-error": [
      "error",
      {
        "allow": [{ "from": "package", "package": "@tanstack/router-core", "name": ["Redirect", "NotFoundError"] }]
      }
    ],
    "typescript/no-confusing-void-expression": ["error", { "ignoreArrowShorthand": true }],
    "typescript/prefer-nullish-coalescing": ["error", { "ignorePrimitives": { "string": true, "boolean": true } }],
    "eslint/eqeqeq": ["error", "always", { "null": "ignore" }],

    // Mistakes agents make: type escapes, dead conditions, suppressed checks, leftovers.
    "typescript/no-unnecessary-condition": "error",
    "typescript/prefer-optional-chain": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-require-imports": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "typescript/consistent-type-imports": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/dot-notation": "error",
    "typescript/consistent-type-assertions": "error",
    "typescript/no-inferrable-types": "error",
    // `@ts-expect-error` needs a reason of at least 10 characters; `@ts-ignore` and `@ts-nocheck` are banned.
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 10
      }
    ],
    "unicorn/no-abusive-eslint-disable": "error",
    "eslint/no-console": "error",
    "eslint/no-empty": ["error", { "allowEmptyCatch": false }],
    "eslint/no-warning-comments": ["error", { "terms": ["todo", "fixme", "xxx", "hack"] }],
    "react/no-danger": "error",
    "react/button-has-type": "error",
    "react/jsx-no-target-blank": "error",
    "eslint/no-new-func": "error",
    "typescript/no-implied-eval": "error",
    "eslint/no-script-url": "error",
    "import/extensions": ["error", "always", { "ignorePackages": true }],
    "import/no-duplicates": "error",
    "import/first": "error",
    "promise/no-nesting": "error",
    "promise/no-return-wrap": "error",
    "promise/prefer-catch": "error",
    "promise/no-return-in-finally": "error",
    // React Compiler bailouts: code the compiler cannot optimize, or a suppressed rule of React.
    "react/syntax": "error",
    "react/todo": "error",
    "react/unsupported-syntax": "error",
    "react/invariant": "error",
    "react/rule-suppression": "error",
    "jsx-a11y/anchor-ambiguous-text": "error",
    "eslint/complexity": ["error", { "max": 20 }],
    "eslint/max-lines-per-function": ["error", { "max": 130, "skipBlankLines": true, "skipComments": true }],

    // TanStack Query and Router (ESLint plugins run by oxlint).
    "@tanstack/query/exhaustive-deps": "error",
    "@tanstack/query/stable-query-client": "error",
    "@tanstack/query/no-rest-destructuring": "error",
    "@tanstack/query/prefer-query-options": "error",
    "@tanstack/router/create-route-property-order": "error",

    "shadcn/no-unknown-classes": "error",
    "shadcn/no-raw-colors": "error",
    "shadcn/no-arbitrary-values": "error",
    "shadcn/no-inline-styles": "error",
    "shadcn/require-static-classes": "error",
    "shadcn/no-restyle": [
      "error",
      {
        "allow": ["layout"],
        "contracts": [
          {
            "pattern": "^CardContent$",
            "allow": ["layout", "spacing"]
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      // Drizzle's schema entry: drizzle-kit (drizzle.config.ts), scripts/check-drift.ts and `drizzle({ schema })`
      // need every table in one module. The only barrel file allowed.
      "files": ["src/server/db/schema/index.ts"],
      "rules": {
        "oxc/no-barrel-file": "off"
      }
    },
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "shadcn/no-restyle": "off",
        "shadcn/no-arbitrary-values": "off"
      }
    },
    {
      // UI code and page routes: data only through the SDK or a server function (AGENTS.md, "Architecture map").
      "files": ["src/components/**", "src/features/**", "src/routes/**/*.tsx"],
      "plugins": ["node"],
      "rules": {
        "node/no-process-env": "error",
        "no-restricted-globals": [
          "error",
          {
            "name": "fetch",
            "message": "UI code calls the API through the generated SDK (#/sdk) or a server function (#/lib/*.functions.ts), never raw fetch."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@tanstack/react-start/server",
                "message": "Server-only helpers. Use a server function in #/lib/*.functions.ts."
              }
            ],
            "patterns": [
              {
                "regex": "^#/server(/|$)",
                "message": "UI code must not import src/server/**. Go through the SDK (#/sdk) or a server function (#/lib/*.functions.ts)."
              },
              {
                "regex": "^(\\.\\./)+server(/|$)",
                "message": "UI code must not import src/server/**. Go through the SDK (#/sdk) or a server function (#/lib/*.functions.ts)."
              },
              {
                "regex": "^(drizzle-orm|pg)(/|$)",
                "message": "UI code must not touch the database. Call the API through the generated SDK (#/sdk)."
              },
              {
                "regex": "^(better-auth|@better-auth)(/|$)",
                "message": "Better Auth runs on the server only, its client included. UI code calls the account server functions in #/lib/auth.functions.ts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/contract/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*", "!effect", "!effect/**", "!./*", "!\\#/contract/*", "!\\#/config/*"],
                "message": "src/contract is the pure API contract: it may import only `effect`, other src/contract modules and src/config."
              }
            ]
          }
        ]
      }
    },
    {
      // Vitest and Playwright share the test API shape the vitest plugin checks.
      "files": ["tests/**"],
      "plugins": ["vitest"],
      "rules": {
        "typescript/no-non-null-assertion": "off",
        // A `describe` callback is a list of tests, not a function to keep short.
        "eslint/max-lines-per-function": "off",
        // `.only` runs one test alone; `.skip` and `.todo` ship a test that checks nothing. A skip that depends on
        // the platform takes a condition (`it.skipIf(...)`).
        "vitest/no-focused-tests": "error",
        "vitest/no-disabled-tests": "error",
        "vitest/warn-todo": "error",
        "vitest/expect-expect": [
          "error",
          {
            "assertFunctionNames": ["expect", "expect.*", "assert.*", "expectAccessible", "tabOrder"]
          }
        ],
        "vitest/no-identical-title": "error",
        "vitest/no-duplicate-hooks": "error",
        "vitest/prefer-hooks-on-top": "error",
        "vitest/require-mock-type-parameters": "error",
        "vitest/no-conditional-expect": "error",
        // pedantic: flags every `??`, ternary and callback in a test body (29 findings, none a hidden branch of the
        // test itself). no-conditional-expect above catches the harmful case: an assertion that may not run.
        "vitest/no-conditional-in-test": "off",
        "vitest/valid-expect": [
          "error",
          {
            "maxArgs": 2
          }
        ],
        "vitest/no-standalone-expect": [
          "error",
          {
            "additionalTestBlockFunctions": ["beforeAll", "beforeEach", "afterEach"]
          }
        ]
      }
    },
    {
      "files": ["scripts/**", "tests/**"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      // Command-line tools: the console is their output.
      "files": ["scripts/**"],
      "rules": {
        "eslint/no-console": "off",
        "eslint/complexity": ["error", { "max": 30 }]
      }
    },

    // Repository rules as syntax selectors. Each list repeats the selectors of the wider globs above it.
    {
      "files": ["src/**"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression:matches([callee.name=/^(spawn|spawnSync|execFile|execFileSync)$/], [callee.property.name=/^(spawn|spawnSync|execFile|execFileSync)$/])[arguments.0.value=/^(pnpm|npm|npx|yarn)$|^node_modules/]",
            "message": "Start pnpm, npm or a node_modules/.bin tool with `xSync` or `x` from tinyexec, not node:child_process: on Windows it is a `.cmd` shim, which Node refuses to start without a shell (CVE-2024-27980)."
          },
          {
            "selector": "TSAsExpression > TSAsExpression.expression[typeAnnotation.type='TSUnknownKeyword']",
            "message": "`as unknown as` switches the type checker off. Decode the value with Effect Schema, or fix the type where it comes from."
          },
          {
            "selector": "Literal[value=/access-control-allow-origin/i], TemplateElement[value.raw=/access-control-allow-origin/i]",
            "message": "CORS does not belong in application code: the app is same-origin (src/start.ts rejects other origins). Serving other origins is a reviewed edge decision in deploy/Caddyfile."
          },
          {
            "selector": "MemberExpression[object.object.type='MetaProperty'][object.property.name='env'][property.name=/^VITE_/]",
            "message": "import.meta.env.VITE_* is compiled into the browser bundle, so its value is public. Read server configuration through src/server/env.ts."
          },
          {
            "selector": "CallExpression[callee.property.name=/^(inputValidator|validator)$/]:not([arguments.0.callee.object.name='Schema'][arguments.0.callee.property.name='toStandardSchemaV1'])",
            "message": "A server function's validator is the only check between the network and its handler. Decode with Effect Schema: `.validator(Schema.toStandardSchemaV1(Schema.Struct({ ... })))`."
          }
        ]
      }
    },
    {
      // Only the two raw routes below serve HTTP themselves; everything else goes through the API contract.
      "files": ["src/routes/**"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression:matches([callee.name=/^(spawn|spawnSync|execFile|execFileSync)$/], [callee.property.name=/^(spawn|spawnSync|execFile|execFileSync)$/])[arguments.0.value=/^(pnpm|npm|npx|yarn)$|^node_modules/]",
            "message": "Start pnpm, npm or a node_modules/.bin tool with `xSync` or `x` from tinyexec, not node:child_process: on Windows it is a `.cmd` shim, which Node refuses to start without a shell (CVE-2024-27980)."
          },
          {
            "selector": "TSAsExpression > TSAsExpression.expression[typeAnnotation.type='TSUnknownKeyword']",
            "message": "`as unknown as` switches the type checker off. Decode the value with Effect Schema, or fix the type where it comes from."
          },
          {
            "selector": "Literal[value=/access-control-allow-origin/i], TemplateElement[value.raw=/access-control-allow-origin/i]",
            "message": "CORS does not belong in application code: the app is same-origin (src/start.ts rejects other origins). Serving other origins is a reviewed edge decision in deploy/Caddyfile."
          },
          {
            "selector": "MemberExpression[object.object.type='MetaProperty'][object.property.name='env'][property.name=/^VITE_/]",
            "message": "import.meta.env.VITE_* is compiled into the browser bundle, so its value is public. Read server configuration through src/server/env.ts."
          },
          {
            "selector": "CallExpression[callee.property.name=/^(inputValidator|validator)$/]:not([arguments.0.callee.object.name='Schema'][arguments.0.callee.property.name='toStandardSchemaV1'])",
            "message": "A server function's validator is the only check between the network and its handler. Decode with Effect Schema: `.validator(Schema.toStandardSchemaV1(Schema.Struct({ ... })))`."
          },
          {
            "selector": "Identifier[name='createServerFileRoute'], Property[key.name='server'] > ObjectExpression.value > Property[key.name='handlers']",
            "message": "A raw HTTP route bypasses the API contract (no openapi.json entry, no SDK, no Authentication middleware). Add an endpoint to src/contract and src/server/api/handlers.ts instead."
          }
        ]
      }
    },
    {
      "files": ["src/routes/api/**"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression:matches([callee.name=/^(spawn|spawnSync|execFile|execFileSync)$/], [callee.property.name=/^(spawn|spawnSync|execFile|execFileSync)$/])[arguments.0.value=/^(pnpm|npm|npx|yarn)$|^node_modules/]",
            "message": "Start pnpm, npm or a node_modules/.bin tool with `xSync` or `x` from tinyexec, not node:child_process: on Windows it is a `.cmd` shim, which Node refuses to start without a shell (CVE-2024-27980)."
          },
          {
            "selector": "Program",
            "message": "src/routes/api holds only the two raw routes, api/$.ts (the Effect API) and api/auth/$.ts (Better Auth). Add an endpoint to src/contract and src/server/api/handlers.ts instead."
          }
        ]
      }
    },
    {
      // The two raw routes: the Effect API and Better Auth. A third one is a reviewed edit here, with its reason.
      "files": ["src/routes/api/$.ts", "src/routes/api/auth/$.ts"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression:matches([callee.name=/^(spawn|spawnSync|execFile|execFileSync)$/], [callee.property.name=/^(spawn|spawnSync|execFile|execFileSync)$/])[arguments.0.value=/^(pnpm|npm|npx|yarn)$|^node_modules/]",
            "message": "Start pnpm, npm or a node_modules/.bin tool with `xSync` or `x` from tinyexec, not node:child_process: on Windows it is a `.cmd` shim, which Node refuses to start without a shell (CVE-2024-27980)."
          },
          {
            "selector": "TSAsExpression > TSAsExpression.expression[typeAnnotation.type='TSUnknownKeyword']",
            "message": "`as unknown as` switches the type checker off. Decode the value with Effect Schema, or fix the type where it comes from."
          },
          {
            "selector": "Literal[value=/access-control-allow-origin/i], TemplateElement[value.raw=/access-control-allow-origin/i]",
            "message": "CORS does not belong in application code: the app is same-origin (src/start.ts rejects other origins). Serving other origins is a reviewed edge decision in deploy/Caddyfile."
          },
          {
            "selector": "MemberExpression[object.object.type='MetaProperty'][object.property.name='env'][property.name=/^VITE_/]",
            "message": "import.meta.env.VITE_* is compiled into the browser bundle, so its value is public. Read server configuration through src/server/env.ts."
          }
        ]
      }
    },
    {
      "files": ["tests/**"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression:matches([callee.name=/^(spawn|spawnSync|execFile|execFileSync)$/], [callee.property.name=/^(spawn|spawnSync|execFile|execFileSync)$/])[arguments.0.value=/^(pnpm|npm|npx|yarn)$|^node_modules/]",
            "message": "Start pnpm, npm or a node_modules/.bin tool with `xSync` or `x` from tinyexec, not node:child_process: on Windows it is a `.cmd` shim, which Node refuses to start without a shell (CVE-2024-27980)."
          },
          {
            "selector": "CallExpression[callee.name='expect'][arguments.0.type='Literal'], CallExpression[callee.name='expect'][arguments.0.type='TemplateLiteral'][arguments.0.expressions.length=0], CallExpression[callee.name='expect'][arguments.0.type='Identifier'][arguments.0.name='undefined']",
            "message": "expect(<literal>) asserts on a constant, so it can never fail. Put the value under test in expect(...)."
          }
        ]
      }
    },
    {
      // Layers that wait for a browser or a server.
      "files": ["tests/component/**", "tests/integration/**", "tests/e2e/**"],
      "rules": {
        "eslint-js/no-restricted-syntax": [
          "error",
          {
            "selector": "CallExpression:matches([callee.name=/^(spawn|spawnSync|execFile|execFileSync)$/], [callee.property.name=/^(spawn|spawnSync|execFile|execFileSync)$/])[arguments.0.value=/^(pnpm|npm|npx|yarn)$|^node_modules/]",
            "message": "Start pnpm, npm or a node_modules/.bin tool with `xSync` or `x` from tinyexec, not node:child_process: on Windows it is a `.cmd` shim, which Node refuses to start without a shell (CVE-2024-27980)."
          },
          {
            "selector": "CallExpression[callee.name='expect'][arguments.0.type='Literal'], CallExpression[callee.name='expect'][arguments.0.type='TemplateLiteral'][arguments.0.expressions.length=0], CallExpression[callee.name='expect'][arguments.0.type='Identifier'][arguments.0.name='undefined']",
            "message": "expect(<literal>) asserts on a constant, so it can never fail. Put the value under test in expect(...)."
          },
          {
            "selector": "CallExpression[callee.name=/^(setTimeout|sleep)$/], CallExpression[callee.property.name=/^(setTimeout|sleep)$/]",
            "message": "A fixed wait is flaky on a slow machine and slow on a fast one. Wait for the condition itself: web-first `await expect(locator)...`, `expect.element`, `expect.poll` or `vi.waitFor`."
          }
        ]
      }
    },
    {
      // Playwright's own rules: oxlint's vitest rules do not recognize Playwright's `test`.
      "files": ["tests/e2e/**"],
      "rules": {
        "playwright/no-focused-test": "error",
        // A skip that depends on the browser takes a condition: `test.skip(({ isMobile }) => isMobile, 'reason')`.
        "playwright/no-skipped-test": ["error", { "allowConditional": true, "disallowFixme": true }],
        "playwright/no-wait-for-timeout": "error"
      }
    }
  ]
}
