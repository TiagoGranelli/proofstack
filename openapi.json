{
  "openapi": "3.1.0",
  "info": {
    "title": "ProofStack API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "system.health",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/ready": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "system.ready",
        "parameters": [],
        "security": [],
        "responses": {
          "200": {
            "description": "Health",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "ServiceUnavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceUnavailableEncoded"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "get": {
        "tags": [
          "Public posts"
        ],
        "operationId": "publicPosts.list",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/PageCursor"
            },
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,3}$",
              "description": "Posts per page, 1 to 50. Default 20."
            },
            "required": false
          }
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "One page of posts, newest first. `nextCursor` is null on the last page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPage"
                }
              }
            }
          },
          "400": {
            "description": "ValidationError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          }
        }
      }
    },
    "/api/me/posts": {
      "get": {
        "tags": [
          "My posts"
        ],
        "operationId": "myPosts.list",
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/PageCursor"
            },
            "required": false
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "string",
              "pattern": "^\\d{1,3}$",
              "description": "Posts per page, 1 to 50. Default 20."
            },
            "required": false
          }
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "One page of posts, newest first. `nextCursor` is null on the last page.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostPage"
                }
              }
            }
          },
          "400": {
            "description": "ValidationError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "My posts"
        ],
        "operationId": "myPosts.create",
        "parameters": [],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "400": {
            "description": "ValidationError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostInput"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api/me/posts/{id}": {
      "patch": {
        "tags": [
          "My posts"
        ],
        "operationId": "myPosts.update",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Post",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Post"
                }
              }
            }
          },
          "400": {
            "description": "ValidationError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "404": {
            "description": "PostNotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostNotFoundEncoded"
                }
              }
            }
          }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostInput"
              }
            }
          },
          "required": true
        }
      },
      "delete": {
        "tags": [
          "My posts"
        ],
        "operationId": "myPosts.remove",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "schema": {
              "type": "string"
            },
            "required": true
          }
        ],
        "security": [
          {
            "sessionCookie": []
          },
          {
            "secureSessionCookie": []
          }
        ],
        "responses": {
          "204": {
            "description": "<No Content>"
          },
          "400": {
            "description": "ValidationError",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationErrorEncoded"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnauthorizedEncoded"
                }
              }
            }
          },
          "404": {
            "description": "PostNotFound",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostNotFoundEncoded"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "ServiceUnavailableEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ServiceUnavailable"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ],
        "additionalProperties": false
      },
      "PageCursor": {
        "type": "string",
        "description": "Opaque cursor from `nextCursor` of the previous page. Omit it for the first page."
      },
      "Post": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "authorName": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "body",
          "authorName",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "PostPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Post"
            }
          },
          "nextCursor": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PageCursor"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "items",
          "nextCursor"
        ],
        "additionalProperties": false,
        "description": "One page of posts, newest first. `nextCursor` is null on the last page."
      },
      "ValidationIssue": {
        "type": "object",
        "properties": {
          "path": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "message"
        ],
        "additionalProperties": false
      },
      "ValidationErrorEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "ValidationError"
            ]
          },
          "message": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssue"
            }
          }
        },
        "required": [
          "_tag",
          "message",
          "issues"
        ],
        "additionalProperties": false
      },
      "UnauthorizedEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "Unauthorized"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "message"
        ],
        "additionalProperties": false
      },
      "PostInput": {
        "type": "object",
        "properties": {
          "body": {
            "type": "string",
            "pattern": "^\\S[\\s\\S]*\\S$|^\\S$|^$",
            "minLength": 1,
            "maxLength": 280
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "PostNotFoundEncoded": {
        "type": "object",
        "properties": {
          "_tag": {
            "type": "string",
            "enum": [
              "PostNotFound"
            ]
          },
          "id": {
            "type": "string"
          }
        },
        "required": [
          "_tag",
          "id"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "sessionCookie": {
        "description": "Better Auth session cookie over http (development).",
        "type": "apiKey",
        "name": "better-auth.session_token",
        "in": "cookie"
      },
      "secureSessionCookie": {
        "description": "Better Auth session cookie when APP_URL is https.",
        "type": "apiKey",
        "name": "__Secure-better-auth.session_token",
        "in": "cookie"
      }
    }
  },
  "security": [],
  "tags": [
    {
      "name": "system"
    },
    {
      "name": "Public posts",
      "description": "Anonymous read access."
    },
    {
      "name": "My posts",
      "description": "CRUD for the signed-in author."
    }
  ]
}
