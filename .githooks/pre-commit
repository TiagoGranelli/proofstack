#!/usr/bin/env bash
# Active by default: `pnpm install` runs the `prepare` script, which sets git core.hooksPath to .githooks
# (`pnpm hooks:uninstall` turns it off until the next install). `git commit --no-verify` skips it once, so it is a
# convenience, not a control: CI runs the same gates on every push and pull request.
# Runs `pnpm check` (the same static gates as CI) on exactly what is being committed. The tree about to be
# committed is copied into a temporary directory and checked there, so the working tree, the index, the
# stash and any merge or cherry-pick state are never touched: unstaged edits, untracked files and edits
# made while the check runs stay where they are.
set -euo pipefail

# Nothing staged (e.g. `git commit --allow-empty`): nothing to check.
if git diff --cached --quiet; then
  exit 0
fi

root=$(git rev-parse --show-toplevel)

# Secrets in the staged changes, when a gitleaks binary is installed (optional: no Docker in the hook). CI's
# `secrets` job scans every commit either way (`pnpm ci:secrets`).
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --redact --no-banner --config "$root/.gitleaks.toml" "$root"
fi

if [ ! -d "$root/node_modules" ]; then
  echo "pre-commit: node_modules is missing; run \`pnpm install\` (or commit with --no-verify)" >&2
  exit 1
fi

tmp=$(mktemp -d "${TMPDIR:-/tmp}/proofstack-pre-commit.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
trap 'exit 130' INT TERM

# The tree git will commit: write-tree honors GIT_INDEX_FILE (set by `git commit -a` and `git commit <paths>`)
# and leaves out intent-to-add entries (`git add -N`), which are not part of the commit. It is checked out
# through a throwaway index so the real one is only read.
tree=$(git write-tree)
mkdir "$tmp/tree"
GIT_INDEX_FILE="$tmp/.index" git read-tree "$tree"
GIT_INDEX_FILE="$tmp/.index" git checkout-index --all --prefix="$tmp/tree/"
rm -f "$tmp/.index"

# Baselines for the gates that compare with what is already committed (scripts/check.ts): HEAD's drizzle/ for the
# applied-migrations guard, and the diff being committed for the `security` gate. The copy has no git history.
mkdir "$tmp/base"
if git rev-parse --verify --quiet HEAD:drizzle >/dev/null; then
  git archive HEAD drizzle | tar -x -C "$tmp/base"
fi
git diff --cached --no-color --no-ext-diff --src-prefix=a/ --dst-prefix=b/ >"$tmp/staged.diff"
export PROOFSTACK_BASE_DIR="$tmp/base" PROOFSTACK_DIFF_FILE="$tmp/staged.diff"

# The gates resolve binaries and packages through this link. They do not depend on git, and none of them
# writes into the repository (check-drift works in its own temporary directory).
ln -s "$root/node_modules" "$tmp/tree/node_modules"
cd "$tmp/tree"
# Git exports these to hooks; nothing in the copy may reach back into the real repository through them.
unset GIT_DIR GIT_INDEX_FILE GIT_WORK_TREE GIT_PREFIX
# pnpm would otherwise notice a project at a new path and "install" it, writing into the linked node_modules.
export pnpm_config_verify_deps_before_run=false
# jiti keys its transpile cache by absolute path, so every temporary copy would add a file to node_modules/.cache.
export JITI_FS_CACHE=false
pnpm run --silent check
