# Reference edge in front of the Node server: TLS, compression, client IP. Used by
# `docker compose --profile edge up`, `pnpm lighthouse` and the test servers with TEST_EDGE=1.
# See docs/operations.md, "Edge proxy (Caddy)".
#
# Environment, read when Caddy starts:
#   EDGE_ADDRESS          Site address. A domain (app.example.com) gets automatic HTTPS (HTTP/2 and HTTP/3);
#                         ":8080" (default) serves plain HTTP/1.1 on every interface. `https://localhost:8443`
#                         gets a certificate from Caddy's internal CA (the Lighthouse gate, scripts/edge.ts).
#   EDGE_HTTP_PORT        Port of the HTTP-to-HTTPS redirect when the address is HTTPS. Default 80.
#   EDGE_UPSTREAM         host:port of the app. Default app:3000 (the compose service).
#   EDGE_TRUSTED_PROXIES  Space-separated CIDRs (or `private_ranges`) of proxies in front of this edge whose
#                         X-Forwarded-For is believed. Empty (default): the TCP peer is the client, and
#                         X-Forwarded-For sent by clients is ignored.
{
	# No admin API: config changes mean a restart, and several edges can share a host network.
	admin off
	http_port {$EDGE_HTTP_PORT:80}
	# A local address (localhost) gets a certificate from Caddy's own CA. Never add that CA to the system
	# trust store; the client that measures through it trusts it explicitly (scripts/edge.ts).
	skip_install_trust
	servers {
		trusted_proxies static {$EDGE_TRUSTED_PROXIES}
		# Walk X-Forwarded-For from the right and stop at the first untrusted address, so a client cannot
		# choose its IP by prepending entries.
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
}

{$EDGE_ADDRESS::8080} {
	# Compresses what the app sends uncompressed (SSR HTML, API JSON). Responses that already carry a
	# Content-Encoding (the build's precompressed .br assets) pass through as they are.
	encode zstd gzip

	# Caddy has no response cache: nothing is stored, and Cache-Control, ETag and Set-Cookie from the app
	# reach the client unchanged. Host, Origin, Referer and Sec-Fetch-* are forwarded as received.
	reverse_proxy {$EDGE_UPSTREAM:app:3000} {
		# The client IP as Caddy resolved it: the TCP peer, or with EDGE_TRUSTED_PROXIES the rightmost
		# untrusted X-Forwarded-For entry. It replaces the whole X-Forwarded-For chain, so the app sees one
		# address plus this edge as the peer, and trusts it with TRUSTED_PROXIES set to the edge's address.
		header_up X-Forwarded-For {client_ip}
	}
}
