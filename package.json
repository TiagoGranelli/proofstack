{
  "name": "proofstack",
  "version": "0.0.0",
  "private": true,
  "description": "Full-stack web application template with a verifiable API contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=12.3.4 <13"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "bootstrap": "node scripts/bootstrap.ts",
    "check": "node scripts/check.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "deadcode": "fallow dead-code",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:uninstall": "git config --unset core.hooksPath",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "auth:generate": "auth generate --config src/server/auth.ts --output src/server/db/schema/auth.ts -y",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.ts",
    "openapi:generate": "node scripts/openapi.ts",
    "sdk:generate": "openapi-ts",
    "codegen": "pnpm openapi:generate && pnpm sdk:generate",
    "test": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:e2e": "playwright test",
    "verify:app": "node scripts/verify-app.ts",
    "check:drift": "node scripts/check-drift.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "db:reset-test": "node --env-file-if-exists=.env scripts/test-db.ts",
    "ci:workflows": "node scripts/ci-jobs.ts workflows",
    "ci:static": "node scripts/ci-jobs.ts static",
    "ci:drift": "node scripts/ci-jobs.ts drift",
    "ci:build": "node scripts/ci-jobs.ts build",
    "ci:verify": "node scripts/ci-jobs.ts verify",
    "ci:lighthouse": "node scripts/ci-jobs.ts lighthouse",
    "ci:docker": "node scripts/ci-jobs.ts docker",
    "ci:local": "node scripts/ci-local.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.58",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "effect": "4.0.0-rc.117",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "1.7.6",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "fallow": "3.29.0",
    "lighthouse": "13.5.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "intent": {
    "skills": [
      "@tanstack/*",
      "fallow"
    ]
  }
}
