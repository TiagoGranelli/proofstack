# The quality gates decide what "done" means for every change, agent-written ones included. A pull request that
# loosens them (a rule turned off, a threshold raised, a module dropped from COVERAGE_GATE, a selector dropped from
# .oxlintrc.json, an entry in PUBLIC_OPERATIONS) needs a review from the owners below. Replace
# @your-org/maintainers with the real team or user, and require code-owner review in the branch protection of
# main; until then this file only suggests reviewers. The last matching pattern wins, so later lines narrow
# earlier ones.

# Lint, types, dead code, complexity, duplication, formatting.
/.oxlintrc.json      @your-org/maintainers
/.oxfmtrc.json       @your-org/maintainers
/.fallowrc.json      @your-org/maintainers
/tsconfig.json       @your-org/maintainers

# Test gates: COVERAGE_GATE and the projects live in vitest.config.ts.
/vitest.config.ts    @your-org/maintainers
/playwright.config.ts @your-org/maintainers

# The gate list and pre-commit hook, the repository rules, the public operations, the drift checks.
/lefthook.yml                        @your-org/maintainers
/tests/unit/repo-policy.test.ts      @your-org/maintainers
/tests/api/public-operations.test.ts @your-org/maintainers
/scripts/check-drift.ts              @your-org/maintainers
/scripts/ci-jobs.ts                  @your-org/maintainers

# Supply chain: exact versions, build-script, release-age and trust exceptions, overrides, vulnerability and
# license exceptions, secret-scan and migration-lint exceptions.
/package.json                 @your-org/maintainers
/pnpm-workspace.yaml          @your-org/maintainers
/.grype.yaml                  @your-org/maintainers
/scripts/licenses.ts          @your-org/maintainers
/scripts/images.ts            @your-org/maintainers
/.gitleaks.toml               @your-org/maintainers
/.gitleaksignore              @your-org/maintainers
/.squawk.toml                 @your-org/maintainers

# CI workflows, actions, Renovate and this file.
/.github/            @your-org/maintainers
/renovate.json       @your-org/maintainers
