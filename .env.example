# Copy to .env for local development (`pnpm bootstrap` does it). Never commit .env.

# --- Local Postgres (compose.yaml reads these from .env) ---
# Docker Compose project name: keeps this checkout's container and volume apart from other projects.
COMPOSE_PROJECT_NAME=proofstack
# Host port and password of the Postgres container. DATABASE_URL below must use the same values.
POSTGRES_PORT=54329
POSTGRES_PASSWORD=proofstack-local

# --- App ---
DATABASE_URL=postgres://proofstack:proofstack-local@127.0.0.1:54329/proofstack
# Public origin of the app (scheme + host + port, no path).
APP_URL=http://localhost:3000
# At least 32 characters. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Set only behind a reverse proxy: the header it sets to the client IP (e.g. x-real-ip). The last
# comma-separated value is used, and only from loopback or private peers. Unset = the TCP peer is the
# client. See docs/operations.md.
TRUSTED_IP_HEADER=
# Postgres connections per process (default 10).
# DATABASE_POOL_MAX=10

# --- Tests (optional) ---
# verify:app, lighthouse and check:drift each create and drop proofstack_<purpose>_<pid>_test next to
# DATABASE_URL. To use a fixed database instead (name must end in _test; it is dropped and recreated at
# the start of the run and not dropped afterwards):
# TEST_DATABASE_URL=postgres://proofstack:proofstack-local@127.0.0.1:54329/proofstack_test
# LIGHTHOUSE_DATABASE_URL=postgres://proofstack:proofstack-local@127.0.0.1:54329/proofstack_lighthouse_test
# DRIFT_DATABASE_URL=postgres://proofstack:proofstack-local@127.0.0.1:54329/proofstack_drift_test
# verify:app keeps its per-run database after the run instead of dropping it.
# KEEP_TEST_DB=1
# verify:app and lighthouse test .output even if it is older than its sources.
# ALLOW_STALE_BUILD=1
# Fixed port for the app verify:app starts (default: a free port).
# VERIFY_PORT=3100
