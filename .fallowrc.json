{
  "$schema": "./node_modules/fallow/schema.json",
  // Entry points on top of the ones fallow detects from package.json and its TanStack Router/Vite/Vitest/Playwright
  // plugins.
  "entry": ["scripts/*.ts", "*.config.ts", "tests/**/*.{test,spec}.ts"],
  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**", "lighthouse-report/**"],
  "ignoreDependencies": [
    // Loaded by oxlint through `jsPlugins` in .oxlintrc.json: Router's create-route-property-order. Pinned exactly;
    // its peer eslint is installed but never run.
    "@tanstack/eslint-plugin-router",
    // Invoked as a CLI (`pnpm exec lighthouse`) by scripts/lighthouse-runs.ts.
    "lighthouse"
  ],
  "rules": {
    // Blocking: structural facts that are always wrong.
    "unused-files": "error",
    "unused-dependencies": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    // An export nobody imports is dead code too. An export that is intentional public surface gets an explicit,
    // commented exception (`overrides`), never a global downgrade. `pnpm deadcode` runs with --fail-on-issues, so a
    // rule Fallow reports at "warn" by default fails as well.
    "unused-exports": "error",
    "unused-types": "error",
    // Vite bundles everything into dist/, so dev vs prod dependency placement has no runtime effect.
    "dev-dependencies-in-production": "off",
    "test-only-dependencies": "off",
    // `pnpm check` gates function complexity (`health` below); CRAP needs per-function coverage, which scripts do not
    // have in `check`, so it would only restate cyclomatic complexity.
    "complexity-crap": "off"
  },
  // The `complexity` job in .config/lefthook.yml (`fallow health --complexity`): a function above either ceiling
  // fails. Cognitive 15 is SonarJS's default (nesting and broken flow weigh more than a flat switch); cyclomatic
  // 20 matches oxlint's `complexity` rule. Refactor an offender into named steps; a function that is genuinely
  // irreducible gets a `thresholdOverrides` entry here with its reason, never a higher global ceiling.
  // The `dupes` job in .config/lefthook.yml (`fallow dupes --threshold 0.000001`): any clone group (defaults: 50
  // tokens and 5 lines, `mild` mode) fails, so the gate starts at zero instead of at a percentage that a 20-line
  // copy-paste would not move. A reviewed, deliberate clone goes in `ignoredClones` as `<fingerprint>:<count>` with
  // a comment. Test files (*.test.*, *.spec.*) stay out through Fallow's default ignores: repeated arrange-and-act
  // steps read better inline than behind a helper.
  "duplicates": {
    "ignore": ["src/routeTree.gen.ts"]
  },
  "health": {
    "maxCognitive": 15,
    "maxCyclomatic": 20,
    // Generated by TanStack Router.
    "ignore": ["src/routeTree.gen.ts"]
  },
  // Zones are matched in order: the first zone whose pattern matches a file wins.
  "boundaries": {
    "zones": [
      // Pure functions: no React, no app code.
      { "name": "lib", "patterns": ["src/lib/**"] },
      // UI that knows no route.
      { "name": "components", "patterns": ["src/components/**"] },
      // Routes, the page shell and the router's entry, and the styles: the app layer that composes components.
      {
        "name": "app",
        "patterns": ["src/routes/**", "index.html", "src/main.tsx", "src/routeTree.gen.ts", "src/styles/**"]
      }
    ],
    // Imports point one way: lib -> components -> app.
    "rules": [
      { "from": "lib", "allow": [] },
      { "from": "components", "allow": ["lib"] },
      { "from": "app", "allow": ["components", "lib"] }
    ],
    "coverage": {
      // A new top-level src/ directory must be given a zone before it can be used.
      "requireAllFiles": true,
      "allowUnmatched": ["scripts/**", "tests/**", "*.config.ts"]
    }
  }
}
