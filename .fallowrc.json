{
  "$schema": "./node_modules/fallow/schema.json",
  // Entry points on top of the ones fallow detects from package.json and its TanStack Router/Vite/Vitest/Playwright/Drizzle plugins.
  "entry": [
    "scripts/*.ts",
    "*.config.ts",
    "tests/**/*.{test,spec}.ts",
    // Referenced by path string from vite.config.ts (nitro.plugins).
    "src/server/nitro/*.ts",
    // Target of components.json `aliases.utils`; the shadcn CLI resolves it when adding components.
    "src/lib/utils.ts"
  ],
  "ignorePatterns": ["node_modules/**", ".output/**", ".nitro/**", ".tanstack/**", "drizzle/**", "repos/**"],
  // Generated by Hey API: stays in the import graph and in the `sdk` zone, but its own dead code is not ours to fix.
  "ignoreFindings": ["src/sdk/**"],
  "ignoreDependencies": [
    // Loaded by oxlint through `jsPlugins` in .oxlintrc.json.
    "@shadcn/lint",
    // Also oxlint `jsPlugins`: TanStack Query's rules (exhaustive-deps, stable-query-client, no-rest-destructuring,
    // prefer-query-options) and Router's create-route-property-order. Pinned exactly; their peer eslint is
    // installed but never run.
    "@tanstack/eslint-plugin-query",
    "@tanstack/eslint-plugin-router",
    // Invoked as a CLI (node_modules/.bin/effect-tsgo) by the `effect` gate in scripts/check.ts.
    "@effect/tsgo",
    // Invoked as a CLI (`pnpm exec lighthouse`) by scripts/lighthouse.ts.
    "lighthouse"
  ],
  "rules": {
    // Blocking: structural facts that are always wrong.
    "unused-files": "error",
    "unused-dependencies": "error",
    "unlisted-dependencies": "error",
    "unresolved-imports": "error",
    "circular-dependencies": "error",
    "boundary-violation": "error",
    // An export nobody imports is dead code too. An export that is intentional public surface gets an explicit,
    // commented exception (`overrides` below), never a global downgrade. `pnpm deadcode` runs with
    // --fail-on-issues, so a rule Fallow reports at "warn" by default fails as well.
    "unused-exports": "error",
    "unused-types": "error",
    // Everything is bundled into .output by Vite/Nitro, so dev vs prod dependency placement has no runtime effect.
    // (react-dom, for one, is imported directly only by tests; the app reaches it through Start.)
    "dev-dependencies-in-production": "off",
    "test-only-dependencies": "off",
    // `pnpm check` gates function complexity (`health` below); CRAP needs per-function coverage, which scripts and
    // the integration-tested server code do not have in `check`, so it would only restate cyclomatic complexity.
    "complexity-crap": "off"
  },
  // The `complexity` gate in scripts/check.ts (`fallow health --complexity`): a function above either ceiling
  // fails. Cognitive 15 is SonarJS's default (nesting and broken flow weigh more than a flat switch); cyclomatic
  // 20 matches oxlint's `complexity` rule. Refactor an offender into named steps; a function that is genuinely
  // irreducible gets a `thresholdOverrides` entry here with its reason, never a higher global ceiling.
  // The `dupes` gate in scripts/check.ts (`fallow dupes`, JSON report): any clone group (defaults: 50 tokens and
  // 5 lines, `mild` mode) fails. Calibration: outside generated code the repository had two groups (13 lines, in
  // scripts) and now has none, so the gate starts at zero instead of at a percentage that a 20-line copy-paste
  // would not move. A reviewed, deliberate clone goes in `ignoredClones` as `<fingerprint>:<count>` with a comment.
  // Test files (*.test.*, *.spec.*) stay out through Fallow's default ignores: they hold 5 small groups (59 lines) of
  // repeated arrange-and-act steps, which read better inline than behind a helper.
  "duplicates": {
    "ignore": ["src/sdk/**", "src/routeTree.gen.ts"]
  },
  "health": {
    "maxCognitive": 15,
    "maxCyclomatic": 20,
    // Generated by Hey API and TanStack Router.
    "ignore": ["src/sdk/**", "src/routeTree.gen.ts"]
  },
  "overrides": [
    {
      // Vendored shadcn primitives keep their full upstream export surface.
      "files": ["src/components/ui/**"],
      "rules": { "unused-exports": "off", "unused-types": "off" }
    }
  ],
  // Zones are matched in order: the first zone whose pattern matches a file wins.
  "boundaries": {
    "zones": [
      // Pure Effect HttpApi contract, shared by server, OpenAPI generation and tests.
      { "name": "contract", "patterns": ["src/contract/**"] },
      // Generated Hey API client (browser + SSR).
      { "name": "sdk", "patterns": ["src/sdk/**"] },
      // Server-only code. Modules import @tanstack/react-start/server-only, except nitro/ plugins and db/schema/,
      // which drizzle-kit and the Better Auth CLI load outside Start.
      { "name": "server", "patterns": ["src/server/**"] },
      // The only non-server modules allowed to reference src/server: HTTP route handlers, server functions
      // (createServerFn), isomorphic factories (createIsomorphicFn), server-only functions (createServerOnlyFn) and
      // the global function middleware (createMiddleware().server). Start's compiler strips their server branches
      // from the client bundle.
      {
        "name": "server-adapters",
        "patterns": [
          "src/routes/api/**",
          "src/lib/*.functions.ts",
          "src/lib/api-client.ts",
          "src/lib/app-origin.ts",
          "src/lib/server-function-errors.ts"
        ]
      },
      // Isomorphic helpers.
      { "name": "lib", "patterns": ["src/lib/**"] },
      // Shared UI with no feature knowledge: shadcn primitives (ui/), error states (errors/), page chrome (layouts/).
      { "name": "components", "patterns": ["src/components/**"] },
      // One zone per src/features/<name> (autoDiscover), so a feature cannot import another feature, not even
      // `import type`. Shared code moves down to components/ or lib/; composition happens in routes.
      { "name": "features", "autoDiscover": ["src/features"] },
      // Route modules, router and Start wiring: the app layer that composes features.
      {
        "name": "app",
        "patterns": ["src/routes/**", "src/router.tsx", "src/routeTree.gen.ts", "src/start.ts", "src/styles/**"]
      }
    ],
    // Imports point one way: components -> features -> app, and everything may use lib, contract and sdk.
    "rules": [
      { "from": "contract", "allow": [] },
      { "from": "sdk", "allow": [] },
      { "from": "server", "allow": ["contract", "sdk"] },
      { "from": "server-adapters", "allow": ["server", "contract", "sdk", "lib"] },
      { "from": "lib", "allow": ["contract", "sdk"] },
      { "from": "components", "allow": ["lib", "contract", "sdk"] },
      { "from": "features", "allow": ["components", "lib", "server-adapters", "contract", "sdk"] },
      { "from": "app", "allow": ["features", "components", "lib", "server-adapters", "contract", "sdk"] }
    ],
    "coverage": {
      // A new top-level src/ directory must be given a zone before it can be used.
      "requireAllFiles": true,
      "allowUnmatched": ["scripts/**", "tests/**", "*.config.ts"]
    }
  }
}
