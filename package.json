{
  "name": "proofstack",
  "version": "0.0.0",
  "private": true,
  "description": "Full-stack web application template with a verifiable API contract.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=26.0.0 <27",
    "pnpm": ">=12.6.0 <13"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.10.0",
      "onFail": "download"
    }
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "prepare": "git rev-parse --is-inside-work-tree >/dev/null 2>&1 && [ -z \"$(git config core.hooksPath)\" ] && git config core.hooksPath .githooks || true",
    "bootstrap": "node scripts/bootstrap.ts",
    "check": "node scripts/check.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --type-aware --deny-warnings",
    "lint:fix": "oxlint --type-aware --fix",
    "typecheck": "tsc --noEmit",
    "deadcode": "fallow dead-code --fail-on-issues",
    "hooks:install": "git config core.hooksPath .githooks",
    "hooks:uninstall": "git config --unset core.hooksPath",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "mail:up": "docker compose up -d --wait mailpit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "auth:check": "auth check schema --config src/server/auth.ts",
    "user:create": "node --env-file-if-exists=.env scripts/create-user.ts",
    "openapi:generate": "node scripts/openapi.ts",
    "sdk:generate": "openapi-ts",
    "codegen": "pnpm openapi:generate && pnpm sdk:generate",
    "test": "vitest run --project integration",
    "test:unit": "vitest run --project unit",
    "test:api": "vitest run --project api",
    "test:component": "vitest run --project component",
    "test:fast": "vitest run --project unit --project api --project component --coverage",
    "test:db": "vitest run --project db",
    "test:e2e": "playwright test",
    "verify:app": "node scripts/verify-app.ts",
    "check:drift": "node scripts/check-drift.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "sbom:release": "pnpm sbom --sbom-format cyclonedx --sbom-type application --prod --out sbom/proofstack.cdx.json",
    "audit:check": "pnpm audit --audit-level high",
    "licenses:check": "node scripts/licenses.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "db:reset-test": "node --env-file-if-exists=.env scripts/test-db.ts",
    "ci:workflows": "node scripts/ci-jobs.ts workflows",
    "ci:static": "node scripts/ci-jobs.ts static",
    "ci:supply-chain": "node scripts/ci-jobs.ts supply-chain",
    "ci:secrets": "node scripts/ci-jobs.ts secrets",
    "ci:drift": "node scripts/ci-jobs.ts drift",
    "ci:build": "node scripts/ci-jobs.ts build",
    "ci:verify": "node scripts/ci-jobs.ts verify",
    "ci:lighthouse": "node scripts/ci-jobs.ts lighthouse",
    "ci:docker": "node scripts/ci-jobs.ts docker",
    "ci:local": "node scripts/ci-local.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.6",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-router-ssr-query": "1.167.3",
    "@tanstack/react-start": "1.168.58",
    "better-auth": "1.7.6",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "drizzle-orm": "0.45.3",
    "effect": "4.0.0-rc.117",
    "nodemailer": "10.0.10",
    "pg": "8.23.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@babel/core": "8.0.6",
    "@effect/tsgo": "0.46.1",
    "@effect/vitest": "4.0.0-rc.117",
    "@hey-api/openapi-ts": "0.0.0-next-20260824173136",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@shadcn/lint": "0.2.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.0",
    "@tanstack/eslint-plugin-router": "1.162.0",
    "@types/node": "26.6.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/browser-playwright": "5.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "auth": "1.7.6",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "fallow": "3.29.0",
    "fast-check": "4.10.2",
    "lighthouse": "13.5.0",
    "msw": "2.15.0",
    "nitro": "3.0.260903-beta",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-eslint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tinyexec": "1.3.1",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2",
    "vitest-browser-react": "2.3.0"
  },
  "intent": {
    "skills": [
      "@tanstack/*",
      "fallow"
    ]
  }
}
