{
  // Oxfmt formats on save and Oxlint fixes on save; both read the repo's .oxfmtrc.json and .oxlintrc.json.
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": { "source.fixAll.oxc": "explicit" },
  // Type-aware rules build the whole TypeScript program; `pnpm lint` runs them. Opt in per machine if you have the memory.
  "oxc.typeAware": false,
  // Markdown is not formatted by oxfmt in this repo (see .oxfmtrc.json).
  "[markdown]": { "editor.formatOnSave": false },

  // TypeScript 7 (Go) language service from the TypeScriptTeam.native-preview extension.
  "js/ts.experimental.useTsgo": true,

  // Generated files: edit their sources instead (src/routes for the route tree, package.json for the lockfile).
  "files.readonlyInclude": {
    "src/routeTree.gen.ts": true,
    "pnpm-lock.yaml": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/dist/**": true,
    "**/.fallow/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/lighthouse-report/**": true
  },
  "search.exclude": {
    "**/dist": true,
    "**/.fallow": true,
    "**/test-results": true,
    "**/playwright-report": true,
    "**/lighthouse-report": true,
    "src/routeTree.gen.ts": true,
    "pnpm-lock.yaml": true
  },
  "files.exclude": {
    "**/.fallow": true
  }
}
