{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:pinDigests", "helpers:pinGitHubActionDigests"],
  "minimumReleaseAge": "7 days",
  "osvVulnerabilityAlerts": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "The image pins in scripts/images.ts, and the quoted build arg of the ci:local runner in .github/compose.ci.yaml. The same depName lands in the same PR, so the copies stay equal (`pnpm ci:workflows` checks).",
      "managerFilePatterns": ["/^scripts/images\\.ts$/", "/^\\.github/compose\\.ci\\.yaml$/"],
      "matchStrings": ["'(?<depName>[a-z0-9./-]+):(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})'"],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "The Node version pnpm downloads (package.json devEngines.runtime).",
      "managerFilePatterns": ["/^package\\.json$/"],
      "matchStrings": ["\"runtime\":\\s*\\{\\s*\"name\":\\s*\"node\",\\s*\"version\":\\s*\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "node",
      "datasourceTemplate": "node-version"
    }
  ],
  "packageRules": [
    {
      "description": "Docker Hub and GHCR do not always report a release time; without this, image updates would wait forever.",
      "matchDatasources": ["docker"],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "The Playwright image ships the browsers of one library version.",
      "matchDepNames": ["mcr.microsoft.com/playwright", "@playwright/test", "playwright"],
      "groupName": "playwright"
    },
    {
      "description": "@types/node follows the Node major in devEngines.",
      "matchPackageNames": ["@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
